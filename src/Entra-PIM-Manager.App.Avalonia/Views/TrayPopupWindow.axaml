<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EntraPimManager.AppAvalonia.ViewModels"
        xmlns:cv="using:EntraPimManager.AppAvalonia.Converters"
        xmlns:auth="using:EntraPimManager.Core.Auth"
        x:Class="EntraPimManager.AppAvalonia.Views.TrayPopupWindow"
        x:DataType="vm:ShellViewModel"
        Title="Entra PIM Manager"
        Width="380" Height="600"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        TransparencyLevelHint="Mica,AcrylicBlur,None"
        Background="Transparent"
        Topmost="True">

  <Window.Resources>
    <!-- One eligibility row. Shared by the plain list and by the children of a
         role node, so the two can never drift apart. -->
    <DataTemplate x:Key="EligibilityRowTemplate" DataType="vm:EligibilityItemViewModel">
      <Border Classes="row" IsVisible="{Binding IsVisible}">
       <Grid ColumnDefinitions="*,Auto">
        <!-- The pin sits outside the activation button, not inside it: the row is
             made non-clickable while its role is active, and pinning has to keep
             working exactly then. -->
        <Button Grid.Column="0"
                Classes="ghost"
                Command="{Binding ActivateCommand}"
                IsHitTestVisible="{Binding CanActivate}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="0">
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Grid.Column="0"
                        Opacity="{Binding LabelOpacity}">
              <!-- Under a role node the heading is the scope: the role name is the
                   node's own caption right above and would just repeat 400 times. -->
              <!-- Medium, not SemiBold: this is the deepest level in the tree, and
                   at SemiBold it weighed exactly as much as the tenant header three
                   levels above it. -->
              <!-- Wraps rather than ellipsis: role names are where the meaning is, and
                   "App and Group Mgmt Operator - Re…" hides the very part that says
                   which restricted variant this is. A second line is cheaper than
                   opening the row to find out. -->
              <TextBlock Text="{Binding PrimaryLabel}"
                         FontSize="{DynamicResource FontBody}"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding KindLabel}"
                         FontSize="{DynamicResource FontSmall}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,2,0,0"
                         IsVisible="{Binding ShowKindLine}" />
              <!-- Azure resource roles only: "Contributor" says nothing
                   without the subscription / resource group it applies to. -->
              <TextBlock Text="{Binding ScopeLabel}"
                         FontSize="{DynamicResource FontSmall}"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding ShowScopeLine}" />
              <!-- Shortcut rows only: tenant and scope, because they stand outside
                   the tenant group that would otherwise say so. -->
              <TextBlock Text="{Binding ContextLine}"
                         FontSize="{DynamicResource FontSmall}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding ContextLine,
                                             Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding ActivationErrorText}"
                         FontSize="{DynamicResource FontCaption}"
                         FontWeight="Medium"
                         Foreground="{DynamicResource DangerBrush}"
                         TextWrapping="Wrap"
                         Margin="0,3,0,0"
                         IsVisible="{Binding ActivationErrorText,
                                             Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
            <!-- Idle: chevron pointing into the activation panel. -->
            <PathIcon Grid.Column="1"
                      Data="M9 6l6 6-6 6"
                      Width="14" Height="14"
                      Foreground="{DynamicResource TextTertiaryBrush}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding CanActivate}" />
            <!-- Busy: spinner while the shell loads the policy + opens the panel.
                 Visible during the 1-3s cold-cache window only; the prefetch
                 usually has the policy ready by the time the user clicks. -->
            <Border Grid.Column="1"
                    Classes="spinner"
                    Width="13" Height="13"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsActivating}">
              <Border.RenderTransform>
                <RotateTransform />
              </Border.RenderTransform>
              <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 1,6.5"
                    Stroke="{DynamicResource AccentBrush}"
                    StrokeThickness="1.6"
                    StrokeLineCap="Round" />
            </Border>
            <Border Grid.Column="1"
                    Background="{DynamicResource SuccessSoftBrush}"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsCurrentlyActive}">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6"
                         Fill="{DynamicResource SuccessBrush}"
                         VerticalAlignment="Center" />
                <TextBlock Text="Active"
                           FontSize="10"
                           FontWeight="Medium"
                           Foreground="{DynamicResource SuccessBrush}" />
              </StackPanel>
            </Border>
          </Grid>
        </Button>

        <Button Grid.Column="1"
                Classes="ghost"
                Padding="7,4"
                Margin="0,0,2,0"
                Command="{Binding TogglePinCommand}"
                ToolTip.Tip="Pin to the top of the list">
          <!-- Text glyphs, not a PathIcon: a hand-drawn pin outline renders as a
               half-filled smudge at 12 px, the same reason the remove buttons in
               this file use U+2715 instead of a path. Hollow when unpinned, solid
               when pinned — same metrics, so the row does not jump on toggle. -->
          <Panel>
            <TextBlock Text="&#x2606;"
                       FontSize="15"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding !IsPinned}" />
            <TextBlock Text="&#x2605;"
                       FontSize="15"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding IsPinned}" />
          </Panel>
        </Button>
       </Grid>
      </Border>
    </DataTemplate>

    <!-- One enrolled account, rendered inside its tenant card. The row reaches its
         own commands (SelectCommand / RemoveCommand) rather than walking up to an
         enclosing items control: nested inside a tenant, that walk would find the
         inner control and silently bind to the wrong data context. -->
    <DataTemplate x:Key="AccountRowTemplate" x:DataType="vm:AccountListItemViewModel">
      <Border CornerRadius="6"
              Background="{DynamicResource Surface2Brush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              Margin="0,0,0,4">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox Grid.Column="0"
                   Margin="6,4"
                   FontSize="{DynamicResource FontSmall}"
                   PlaceholderText="Alias, e.g. EADM"
                   Text="{Binding AliasDraft}"
                   IsVisible="{Binding IsRenaming}"
                   KeyDown="OnAliasBoxKeyDown" />

          <Button Grid.Column="0"
                  Classes="ghost"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="10,8"
                  IsVisible="{Binding !IsRenaming}"
                  Command="{Binding SelectCommand}"
                  CommandParameter="{Binding Account}">
            <Grid ColumnDefinitions="Auto,*" IsHitTestVisible="False">
              <Border Grid.Column="0"
                      Width="30" Height="30"
                      CornerRadius="15"
                      Background="{DynamicResource AccentSoftBrush}"
                      VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName, Converter={x:Static cv:InitialsConverter.Instance}}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="{DynamicResource FontBody}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <!-- The UPN keeps its own line: the alias is a convenience, never a
                     disguise for which identity this actually is. -->
                <TextBlock Text="{Binding Username}"
                           FontSize="{DynamicResource FontSmall}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="PrefixCharacterEllipsis"
                           ToolTip.Tip="{Binding Username}" />

                <Border IsVisible="{Binding IsDeviceCodeAccount}"
                        Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="5,1"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0"
                        ToolTip.Tip="Signed in with a device code. Roles protected by a Conditional Access authentication context cannot be activated with this sign-in method — remove the account and add it again using the standard sign-in.">
                  <TextBlock Text="Device code"
                             FontSize="{DynamicResource FontSmall}"
                             FontWeight="Medium"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
              </StackPanel>
            </Grid>
          </Button>

          <Button Grid.Column="1"
                  Classes="ghost"
                  Padding="10,6"
                  IsVisible="{Binding !IsRenaming}"
                  Click="OnRenameAccountClick"
                  ToolTip.Tip="Rename this account">
            <TextBlock Text="&#x270E;"
                       FontSize="13"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
          </Button>

          <Button Grid.Column="1"
                  Classes="ghost"
                  Padding="10,6"
                  IsVisible="{Binding IsRenaming}"
                  Command="{Binding CommitRenameCommand}"
                  ToolTip.Tip="Save the alias (Enter). An empty field clears it.">
            <TextBlock Text="&#x2713;"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
          </Button>

          <Button Grid.Column="2"
                  Classes="ghost"
                  Padding="10,6"
                  CornerRadius="0,6,6,0"
                  IsVisible="{Binding !IsRenaming}"
                  Command="{Binding RemoveCommand}"
                  CommandParameter="{Binding Account}"
                  ToolTip.Tip="Remove this account">
            <TextBlock Text="&#x2715;"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
          </Button>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- One tenant: its registration, its ticket system, and the accounts signed
         into it. The drag handle sits here rather than on the account rows — the
         tenant is what the list is ordered by, and the flat account order is
         derived from it on drop. A tenant nobody is signed into has no place in
         that flat order, so it carries no handle. -->
    <DataTemplate x:Key="TenantNodeTemplate" x:DataType="vm:TenantNodeViewModel">
      <Border Background="{DynamicResource Surface1Brush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="0,0,0,6"
              DragDrop.AllowDrop="True"
              DragDrop.DragOver="OnTenantRowDragOver"
              DragDrop.Drop="OnTenantRowDrop">
        <StackPanel Spacing="6">

          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Border Grid.Column="0"
                    Width="22"
                    Background="Transparent"
                    Cursor="SizeAll"
                    IsVisible="{Binding HasAccounts}"
                    ToolTip.Tip="Drag to reorder tenants"
                    PointerPressed="OnTenantRowPointerPressed"
                    PointerMoved="OnTenantRowPointerMoved"
                    PointerReleased="OnTenantRowPointerReleased">
              <TextBlock Text="&#x22EE;&#x22EE;"
                         FontSize="14"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="3" Margin="0,10,0,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="{Binding Title}"
                           FontSize="{DynamicResource FontBody}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip.Tip="{Binding TenantId}" />
                <Border Grid.Column="1"
                        Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !IsChina}">
                  <TextBlock Text="{Binding CloudName}"
                             FontSize="10"
                             FontWeight="Medium"
                             Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <Border Grid.Column="1"
                        Background="{DynamicResource WarningSoftBrush}"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsChina}">
                  <TextBlock Text="{Binding CloudName}"
                             FontSize="10"
                             FontWeight="Medium"
                             Foreground="{DynamicResource WarningBrush}" />
                </Border>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{DynamicResource SuccessBrush}"
                         IsVisible="{Binding IsVerified}" />
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{DynamicResource WarningBrush}"
                         IsVisible="{Binding !IsVerified}" />
                <TextBlock Text="{Binding Status}"
                           FontSize="{DynamicResource FontSmall}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2"
                    Classes="ghost"
                    Padding="10,6"
                    VerticalAlignment="Top"
                    Command="{Binding ToggleConfigCommand}"
                    ToolTip.Tip="App Registration and ticket system for this tenant">
              <TextBlock Text="&#x2699;"
                         FontSize="14"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center" />
            </Button>

            <Button Grid.Column="3"
                    Classes="ghost"
                    Padding="10,6"
                    CornerRadius="0,6,0,0"
                    VerticalAlignment="Top"
                    IsVisible="{Binding HasRegistration}"
                    Command="{Binding RemoveCommand}"
                    ToolTip.Tip="Remove this tenant's App Registration. Accounts already signed in keep their entry.">
              <TextBlock Text="&#x2715;"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource DangerBrush}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center" />
            </Button>
          </Grid>

          <!-- Configuration. The tenant id is shown, not edited: it is this card's
               identity, so changing it names a different tenant — that is a remove
               and an add, not an edit. -->
          <StackPanel IsVisible="{Binding IsConfigExpanded}" Spacing="6" Margin="12,2,12,4">
            <TextBlock FontFamily="Consolas, Cascadia Mono, monospace"
                       FontSize="{DynamicResource FontSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis">
              <Run Text="Tenant " Foreground="{DynamicResource TextTertiaryBrush}" /><Run Text="{Binding TenantId}" />
            </TextBlock>
            <TextBox Text="{Binding ClientIdDraft}"
                     PlaceholderText="Client id — 00000000-0000-0000-0000-000000000000"
                     FontSize="{DynamicResource FontBody}" />
            <TextBox Text="{Binding LabelDraft}"
                     PlaceholderText="Label (optional)"
                     FontSize="{DynamicResource FontBody}" />
            <TextBox Text="{Binding TicketSystemDraft}"
                     PlaceholderText="Ticket system (optional) — e.g. ServiceNow"
                     ToolTip.Tip="Prefilled into the activation form for this tenant when a role requires a ticket. Takes effect immediately and stays editable per activation."
                     FontSize="{DynamicResource FontBody}" />
            <Button Classes="primary"
                    HorizontalAlignment="Right"
                    Content="Save"
                    Command="{Binding SaveCommand}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Accounts}"
                        Margin="12,0,8,0"
                        ItemTemplate="{StaticResource AccountRowTemplate}" />

          <Button Classes="ghost"
                  Margin="12,0,8,0"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="10,6"
                  IsEnabled="{Binding CanAddAccount}"
                  Command="{Binding AddAccountCommand}"
                  ToolTip.Tip="{Binding AddAccountHint}">
            <TextBlock Text="+ Add account…"
                       FontSize="{DynamicResource FontSmall}"
                       VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Border>
    </DataTemplate>


    <!-- One Azure resource role with every scope the account holds it on. Hoisted out
         of the tenant template so the section template below stays readable. -->
    <DataTemplate x:Key="AzureRoleNodeTemplate" x:DataType="vm:AzureRoleGroup">
      <StackPanel IsVisible="{Binding IsVisible}">
        <Button Classes="ghost"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="6,4"
                Command="{Binding ToggleExpansionCommand}">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <PathIcon Grid.Column="0"
                      Data="M9 6l6 6-6 6"
                      Width="11" Height="11"
                      Foreground="{DynamicResource TextTertiaryBrush}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding !IsExpanded}" />
            <PathIcon Grid.Column="0"
                      Data="M6 9l6 6 6-6"
                      Width="11" Height="11"
                      Foreground="{DynamicResource TextTertiaryBrush}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsExpanded}" />
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       Text="{Binding DisplayName}"
                       FontSize="{DynamicResource FontBody}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
              <!-- A collapsed node must still admit that one of its scopes is
                   granting access right now. -->
              <Border Background="{DynamicResource SuccessSoftBrush}"
                      CornerRadius="4"
                      Padding="6,2"
                      IsVisible="{Binding HasActive}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6"
                           Fill="{DynamicResource SuccessBrush}"
                           VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ActiveLabel}"
                             FontSize="10"
                             FontWeight="Medium"
                             Foreground="{DynamicResource SuccessBrush}" />
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding ScopeCountLabel}"
                         FontSize="{DynamicResource FontSmall}"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Button>

        <ItemsControl ItemsSource="{Binding Items}"
                      IsVisible="{Binding IsExpanded}"
                      ItemTemplate="{StaticResource EligibilityRowTemplate}"
                      Margin="18,0,0,0" />
      </StackPanel>
    </DataTemplate>

    <!-- One kind of eligibility inside a tenant: directory roles, administrative units,
         groups, Azure resources. The header states the kind once, so the rows beneath it
         no longer have to repeat it — except for groups, where membership and ownership
         share a section and the row's kind line is the flag. -->
    <DataTemplate x:Key="EligibilitySectionTemplate" x:DataType="vm:EligibilitySection">
      <StackPanel IsVisible="{Binding IsVisible}" Margin="0,0,0,2">
        <Button Classes="ghost"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="6,3"
                Command="{Binding ToggleExpansionCommand}">
          <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <PathIcon Grid.Column="0"
                      Data="M9 6l6 6-6 6"
                      Width="10" Height="10"
                      Foreground="{DynamicResource TextTertiaryBrush}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding !IsExpanded}" />
            <PathIcon Grid.Column="0"
                      Data="M6 9l6 6 6-6"
                      Width="10" Height="10"
                      Foreground="{DynamicResource TextTertiaryBrush}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsExpanded}" />
            <!-- Caption style, like PINNED and ELIGIBILITIES: a section header labels
                 the block beneath it, it does not compete with it. The title arrives
                 already upper-cased — Avalonia has no text-transform. -->
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       Text="{Binding Title}"
                       FontSize="{DynamicResource FontCaption}"
                       FontWeight="Medium"
                       LetterSpacing="0.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
              <!-- Folding a section away must not fold away the fact that something
                   behind it is granting access. -->
              <Border Background="{DynamicResource SuccessSoftBrush}"
                      CornerRadius="4"
                      Padding="6,2"
                      IsVisible="{Binding HasActive}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6"
                           Fill="{DynamicResource SuccessBrush}"
                           VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ActiveLabel}"
                             FontSize="10"
                             FontWeight="Medium"
                             Foreground="{DynamicResource SuccessBrush}" />
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding MatchCount, StringFormat='({0})'}"
                         FontSize="{DynamicResource FontCaption}"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Button>

        <ItemsControl ItemsSource="{Binding RoleGroups}"
                      IsVisible="{Binding IsExpanded}"
                      ItemTemplate="{StaticResource AzureRoleNodeTemplate}"
                      Margin="14,0,0,0" />

        <ItemsControl ItemsSource="{Binding Items}"
                      IsVisible="{Binding IsExpanded}"
                      ItemTemplate="{StaticResource EligibilityRowTemplate}"
                      Margin="14,0,0,0" />
      </StackPanel>
    </DataTemplate>

  </Window.Resources>

  <!-- Outer rounded shell with drop shadow — gives the popup a "lifted" feel. -->
  <Border CornerRadius="12"
          Background="{DynamicResource SurfaceBaseBrush}"
          BoxShadow="{DynamicResource ShadowPopup}"
          Margin="4">

    <Grid RowDefinitions="*,Auto">

      <!-- Row 0: content stack (scroll + overlays). Footer in row 1 sits below. -->
      <Grid Grid.Row="0">

      <!-- ============================== -->
      <!-- Main content                   -->
      <!-- ============================== -->

      <ScrollViewer Classes="popup">
        <StackPanel Margin="12,10" Spacing="10">

          <!-- Title strip: app name · stats · refresh · settings.
               Replaces the old HERO bar. The popup is global-by-default now —
               no per-account filtering, so the per-account avatar/name was
               misleading affordance. -->
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center" Margin="2,2,2,2">
            <TextBlock Grid.Column="0"
                       Text="Entra PIM Manager"
                       FontSize="{DynamicResource FontSubtitle}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />

            <!-- Stats: "X eligible · Y active". Replaced by a loading caption
                 while a refresh is in flight so the user sees the app is
                 working and not just frozen. -->
            <TextBlock Grid.Column="1"
                       Text="{Binding StatsLabel}"
                       FontSize="{DynamicResource FontSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding !IsBusy}" />
            <TextBlock Grid.Column="1"
                       Text="Loading your roles…"
                       FontSize="{DynamicResource FontSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding IsBusy}" />

            <Button Grid.Column="2"
                    Classes="icon"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    ToolTip.Tip="Refresh">
              <Panel>
                <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                          Width="14" Height="14"
                          IsVisible="{Binding !IsBusy}" />
                <Border Classes="spinner" Width="13" Height="13"
                        IsVisible="{Binding IsBusy}">
                  <Border.RenderTransform>
                    <RotateTransform />
                  </Border.RenderTransform>
                  <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 1,6.5"
                        Stroke="{DynamicResource TextSecondaryBrush}"
                        StrokeThickness="1.6"
                        StrokeLineCap="Round" />
                </Border>
              </Panel>
            </Button>

            <Button Grid.Column="3"
                    Classes="icon"
                    Command="{Binding OpenSettingsPanelCommand}"
                    ToolTip.Tip="Settings"
                    Margin="2,0,0,0">
              <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94 0 .31.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                        Width="14" Height="14" />
            </Button>
          </Grid>

          <!-- ===== ACTIVE — only visible when there are active assignments ===== -->
          <Border Classes="section"
                  IsVisible="{Binding ActiveCount}">
            <StackPanel Spacing="6">
              <TextBlock Text="ACTIVE"
                         FontSize="{DynamicResource FontCaption}"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         Margin="2,0,0,2" />

              <ItemsControl ItemsSource="{Binding ActiveAssignments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ActiveAssignmentItemViewModel">
                    <Border Classes="active" Margin="0,0,0,6">
                      <Grid RowDefinitions="Auto,Auto">
                      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">

                        <!-- Live dot -->
                        <Ellipse Grid.Column="0"
                                 Width="8" Height="8"
                                 Fill="{DynamicResource SuccessBrush}"
                                 VerticalAlignment="Center" />

                        <!-- Title + meta: role name / UPN / tenant · role kind so the
                             user can read off "who activated what in which tenant".
                             The danger-coloured error caption at the bottom is only
                             visible after a failed deactivation (e.g. PIM's
                             eventual-consistency race after the silent retry) — it
                             stays put so users never lose the signal when a Windows
                             toast gets suppressed by Focus Assist. -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                          <TextBlock Text="{Binding DisplayName}"
                                     FontSize="{DynamicResource FontBody}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextTrimming="CharacterEllipsis" />
                          <!-- Alias when the user set one, UPN otherwise. The UPN is
                               trimmed in the middle (a 380 px window cuts off exactly
                               the tail that distinguishes two admin accounts), with
                               the full value one hover away. -->
                          <TextBlock Text="{Binding AliasOrUpn}"
                                     FontSize="{DynamicResource FontSmall}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     TextTrimming="PrefixCharacterEllipsis"
                                     ToolTip.Tip="{Binding Username}" />
                          <!-- Tenant · kind as ONE bound string. Three TextBlocks in a
                               horizontal StackPanel would never ellipsize: that panel
                               measures children against infinite width, so a long
                               tenant name overflowed this column and painted over the
                               countdown. See ActiveAssignmentItemViewModel.MetaLine. -->
                          <TextBlock Text="{Binding MetaLine}"
                                     FontSize="{DynamicResource FontSmall}"
                                     Foreground="{DynamicResource TextTertiaryBrush}"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding MetaTooltip}" />
                          <TextBlock Text="{Binding DeactivationErrorText}"
                                     FontSize="{DynamicResource FontCaption}"
                                     FontWeight="Medium"
                                     Foreground="{DynamicResource DangerBrush}"
                                     TextWrapping="Wrap"
                                     Margin="0,3,0,0"
                                     IsVisible="{Binding DeactivationErrorText,
                                                         Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <!-- Remaining time as plain text. It deliberately competes
                             for no more width than the string itself needs — the
                             progress fraction moved to the full-width bar below, so
                             nothing here has to be wide enough to contain "7h 53m"
                             inside a shape. Colour escalates accent → warning
                             (≤15 min) → danger (≤5 min) via RemainingTime, and the
                             text is hidden while a pending/deactivating spinner
                             occupies this column. -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RemainingText}"
                                   FontFamily="Inter, Consolas, monospace"
                                   FontSize="{DynamicResource FontSmall}"
                                   FontWeight="SemiBold"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !IsBusy}"
                                   Foreground="{Binding RemainingTime,
                                                        Converter={x:Static vm:RemainingTimeToBrushConverter.Instance},
                                                        FallbackValue={DynamicResource TextPrimaryBrush}}" />

                        <!-- Pending indicator: spinner + "Activating…" replaces the
                             countdown until the real assignment shows up. -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsPending}">
                          <Border Classes="spinner" Width="13" Height="13">
                            <Border.RenderTransform>
                              <RotateTransform />
                            </Border.RenderTransform>
                            <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 1,6.5"
                                  Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" />
                          </Border>
                          <TextBlock Text="Activating…"
                                     FontSize="{DynamicResource FontSmall}"
                                     Foreground="{DynamicResource AccentTextBrush}"
                                     VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Deactivating indicator: spinner + "Deactivating…" replaces
                             the countdown while Graph processes the deactivation. -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="10,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsDeactivating}">
                          <Border Classes="spinner" Width="13" Height="13">
                            <Border.RenderTransform>
                              <RotateTransform />
                            </Border.RenderTransform>
                            <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 1,6.5"
                                  Stroke="{DynamicResource DangerBrush}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round" />
                          </Border>
                          <TextBlock Text="Deactivating…"
                                     FontSize="{DynamicResource FontSmall}"
                                     Foreground="{DynamicResource DangerBrush}"
                                     VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Deactivate icon-button — stop square, hover turns danger-red.
                             Hidden during pending/deactivating so the user can't
                             double-click while a transition is in flight. Hard-
                             disabled for the first 5 min after activation:
                             Microsoft enforces a minimum active duration before
                             selfDeactivate is accepted ("The Active duration is
                             too short. Minimum Required is 5 minutes."). The
                             tooltip explains the policy and surfaces the
                             remaining wait time. -->
                        <Button Grid.Column="3"
                                Classes="icon danger"
                                Command="{Binding DeactivateCommand}"
                                ToolTip.Tip="{Binding DeactivateTooltip}"
                                ToolTip.ShowOnDisabled="True"
                                IsEnabled="{Binding !IsInProvisioningWindow}"
                                IsVisible="{Binding !IsBusy}">
                          <!-- Foreground pinned directly on the PathIcon: the
                               .icon:pointerover rule from Buttons.axaml swaps the
                               Button-level Foreground to TextPrimaryBrush on
                               hover, and PathIcon's inheritance picks that up
                               before the .icon.danger:pointerover override can
                               re-pin it. Inlining the brush on the glyph itself
                               sidesteps the style-precedence quirk entirely. -->
                          <PathIcon Data="M6 6h12v12H6z"
                                    Width="11" Height="11"
                                    Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                      </Grid>

                      <!-- Countdown as a hairline across the card. Spanning the full
                           width rather than sitting in the row means the indicator
                           costs zero horizontal budget — no amount of tenant-name
                           length can crowd it — and a wide bar is far easier to read
                           from the corner of the eye than a 44px arc, which is the
                           whole point of a tray tool. ProgressBar handles the 0..1
                           fraction natively, so no geometry converter is involved.
                           MinHeight="0" is required: the Fluent theme's default
                           would otherwise keep it several pixels tall. -->
                      <ProgressBar Grid.Row="1"
                                   Minimum="0"
                                   Maximum="1"
                                   Value="{Binding ProgressFraction}"
                                   Height="2"
                                   MinHeight="0"
                                   CornerRadius="1"
                                   Margin="0,8,0,0"
                                   IsVisible="{Binding !IsBusy}"
                                   Background="{DynamicResource BorderDividerBrush}"
                                   Foreground="{Binding RemainingTime,
                                                        Converter={x:Static vm:RemainingTimeToBrushConverter.Instance},
                                                        FallbackValue={DynamicResource AccentTextBrush}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- ===== ELIGIBILITIES ===== -->
          <Border Classes="section">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,2">
                <TextBlock Grid.Column="0"
                           Text="ELIGIBILITIES"
                           FontSize="{DynamicResource FontCaption}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding EligibleCount, StringFormat='({0})'}"
                           FontSize="{DynamicResource FontCaption}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
              </Grid>

              <!-- First-run empty state: no tenant configured. CTA opens Settings →
                   the TENANTS section is at the top and forces itself open while
                   nothing is configured, so a simple open is enough. -->
              <Border CornerRadius="8"
                      Background="{DynamicResource Surface1Brush}"
                      Padding="14"
                      IsVisible="{Binding NeedsConfiguration}">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                  <TextBlock Text="Welcome to Entra PIM Manager"
                             FontSize="{DynamicResource FontSubtitle}"
                             FontWeight="Medium"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="To get started, configure your Entra App Registration."
                             FontSize="{DynamicResource FontBody}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             MaxWidth="320" />
                  <Button Classes="primary"
                          Command="{Binding OpenSettingsPanelCommand}"
                          HorizontalAlignment="Center">
                    <TextBlock Text="Set up your first tenant" />
                  </Button>
                </StackPanel>
              </Border>

              <!-- Empty state: configured but no accounts enrolled yet. CTA opens
                   Settings, where each tenant card carries its own "Add account". -->
              <Border CornerRadius="8"
                      Background="{DynamicResource Surface1Brush}"
                      Padding="14"
                      IsVisible="{Binding HasNoAccounts}">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                  <TextBlock Text="No accounts connected yet."
                             FontSize="{DynamicResource FontBody}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             HorizontalAlignment="Center" />
                  <Button Classes="primary"
                          Command="{Binding OpenSettingsPanelCommand}"
                          HorizontalAlignment="Center">
                    <TextBlock Text="+ Add an admin account" />
                  </Button>
                </StackPanel>
              </Border>

              <!-- Search bar -->
              <Border Background="{DynamicResource Surface1Brush}"
                      CornerRadius="6"
                      Padding="8,1"
                      IsVisible="{Binding ShowEligibilityUi}">
                <Grid ColumnDefinitions="Auto,*">
                  <PathIcon Grid.Column="0"
                            Data="M11 17a6 6 0 1 0 0-12 6 6 0 0 0 0 12zM21 21l-5-5"
                            Width="13" Height="13"
                            Foreground="{DynamicResource TextTertiaryBrush}"
                            VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding FilterText}"
                           PlaceholderText="Search…"
                           BorderThickness="0"
                           Background="Transparent"
                           Padding="8,6,0,6"
                           FontSize="{DynamicResource FontBody}" />
                </Grid>
              </Border>

              <!-- Shortcuts: pinned first, then the last activations. Both are views
                   over the rows below, so the long list stays the exception path for
                   anyone who works with the same handful of roles every day. Hidden
                   while a search is running — the same hit twice is only noise. -->
              <StackPanel Spacing="4" IsVisible="{Binding HasShortcuts}">
                <TextBlock Text="PINNED"
                           FontSize="{DynamicResource FontCaption}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="2,2,0,0"
                           IsVisible="{Binding PinnedItems.Count}" />
                <ItemsControl ItemsSource="{Binding PinnedItems}"
                              ItemTemplate="{StaticResource EligibilityRowTemplate}" />

                <TextBlock Text="RECENT"
                           FontSize="{DynamicResource FontCaption}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="2,4,0,0"
                           IsVisible="{Binding RecentItems.Count}" />
                <ItemsControl ItemsSource="{Binding RecentItems}"
                              ItemTemplate="{StaticResource EligibilityRowTemplate}" />

                <Border Height="1"
                        Background="{DynamicResource BorderDividerBrush}"
                        Margin="0,6,0,2" />
              </StackPanel>

              <!-- Grouped list: one collapsible section per enrolled tenant.
                   IsVisible on the group hides it when filter matches nothing. -->
              <ItemsControl ItemsSource="{Binding EligibilityGroups}"
                            IsVisible="{Binding ShowEligibilityUi}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:TenantEligibilityGroup">
                    <!-- Tight inside, loose between: the gap under a group has to be
                         clearly larger than the gaps within it, or two tenants read as
                         one list. -->
                    <StackPanel Spacing="2"
                                Margin="0,0,0,12"
                                IsVisible="{Binding IsVisible}">

                      <!-- Header: clicking toggles IsExpanded. Chevron rotates
                           via two PathIcon swaps (Avalonia's RenderTransform
                           bindings can't express a conditional rotation in XAML
                           without a value converter). -->
                      <Button Classes="ghost"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="6,4"
                              Command="{Binding ToggleExpansionCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                          <!-- Collapsed: chevron-right. Larger and a step brighter than
                               the section chevron below it — this is the outermost level
                               of the tree and has to read that way. -->
                          <PathIcon Grid.Column="0"
                                    Data="M9 6l6 6-6 6"
                                    Width="13" Height="13"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding !IsExpanded}" />
                          <!-- Expanded: chevron-down -->
                          <PathIcon Grid.Column="0"
                                    Data="M6 9l6 6 6-6"
                                    Width="13" Height="13"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsExpanded}" />

                          <StackPanel Grid.Column="1"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding TenantLabel}"
                                       FontSize="{DynamicResource FontSubtitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding TenantId}" />
                            <TextBlock Text="{Binding AliasOrUpn}"
                                       FontSize="{DynamicResource FontSmall}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="PrefixCharacterEllipsis"
                                       ToolTip.Tip="{Binding Username}" />
                          </StackPanel>

                          <StackPanel Grid.Column="2"
                                      Orientation="Horizontal"
                                      Spacing="6"
                                      VerticalAlignment="Center">
                            <!-- Same pill the sections and role nodes carry. A tenant is
                                 collapsed by default, and folding it away must not fold
                                 away the fact that something inside it is granting
                                 access right now. -->
                            <Border Background="{DynamicResource SuccessSoftBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    IsVisible="{Binding HasActive}">
                              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6"
                                         Fill="{DynamicResource SuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveLabel}"
                                           FontSize="10"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource SuccessBrush}" />
                              </StackPanel>
                            </Border>
                            <!-- The count sits in a pill here and flat on the sections:
                                 three levels whose right-hand side looked identical is
                                 half of why the tree read flat. -->
                            <Border Background="{DynamicResource Surface2Brush}"
                                    CornerRadius="10"
                                    Padding="7,1">
                              <TextBlock Text="{Binding MatchCount}"
                                         FontSize="{DynamicResource FontCaption}"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center" />
                            </Border>
                          </StackPanel>
                        </Grid>
                      </Button>

                      <!-- Fetch failure (e.g. no PIM licence): shown regardless
                           of expansion so the tenant doesn't read as a bare "(0)". -->
                      <Border Background="{DynamicResource WarningSoftBrush}"
                              CornerRadius="4"
                              Padding="8,5"
                              Margin="25,0,0,0"
                              IsVisible="{Binding LoadError,
                                          Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding LoadError, StringFormat='⚠ {0}'}"
                                   FontSize="{DynamicResource FontSmall}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   TextWrapping="Wrap" />
                      </Border>

                      <!-- One collapsible section per kind. This is what keeps a large
                           tenant readable: four lines instead of several hundred, and a
                           tenant below this one reachable without scrolling past them.

                           The hairline on the left is the tree spine — it answers "where
                           does this tenant end" while scrolling, which indentation on its
                           own does not. BorderSubtle rather than BorderDivider: the
                           divider token is #F4F4F5 against a #F7F7F7 page, so the rail
                           would be invisible in light mode and nothing would report it.
                           IsVisible sits on the border so the line never draws over
                           nothing. -->
                      <Border Margin="12,0,0,0"
                              Padding="12,2,0,0"
                              BorderThickness="1,0,0,0"
                              BorderBrush="{DynamicResource BorderSubtleBrush}"
                              IsVisible="{Binding IsExpanded}">
                        <ItemsControl ItemsSource="{Binding Sections}"
                                      ItemTemplate="{StaticResource EligibilitySectionTemplate}" />
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ============================== -->
      <!-- Slide-in activation overlay    -->
      <!-- ============================== -->

      <Border IsVisible="{Binding ActivationPanel.IsOpen}"
              Background="{DynamicResource Surface1Brush}"
              CornerRadius="12"
              Padding="14"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <Border.RenderTransform>
          <TranslateTransform X="{Binding ActivationPanel.PanelOffsetX}" />
        </Border.RenderTransform>
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="(TranslateTransform.X)"
                              Duration="0:0:0.28"
                              Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>

        <Grid RowDefinitions="Auto,*,Auto"
              DataContext="{Binding ActivationPanel}"
              x:DataType="vm:ActivationPanelViewModel">

          <!-- Header -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0"
                    Classes="icon"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Back">
              <PathIcon Data="M15 6l-6 6 6 6" Width="14" Height="14" />
            </Button>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding ResourceName}"
                         FontSize="{DynamicResource FontTitleSmall}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding AccountLabel, StringFormat='Account: {0}'}"
                         FontSize="{DynamicResource FontSmall}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Grid>

          <!-- Body -->
          <ScrollViewer Grid.Row="1" Margin="0,18,0,0" Classes="popup">
            <StackPanel Spacing="14">

              <!-- Duration slider -->
              <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                  <TextBlock Grid.Column="0"
                             Text="Duration"
                             FontSize="{DynamicResource FontCaption}"
                             FontWeight="Medium"
                             Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding DurationHours, StringFormat='{}{0:0.0} h'}"
                             FontSize="{DynamicResource FontBody}"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentTextBrush}" />
                </Grid>
                <!-- 0.5h steps to match the Entra portal's PIM activation UI;
                     keeps user expectations aligned across both surfaces. -->
                <Slider Minimum="0.5"
                        Maximum="{Binding MaxDurationHours}"
                        Value="{Binding DurationHours}"
                        SmallChange="0.5" LargeChange="1"
                        TickFrequency="0.5" IsSnapToTickEnabled="True" />
              </StackPanel>

              <!-- Justification + saved favourites. Textbox stays anchored
                   directly under the label so saving a new chip doesn't push
                   it down. -->
              <StackPanel IsVisible="{Binding RequiresJustification}" Spacing="4">
                <TextBlock Text="Justification"
                           FontSize="{DynamicResource FontCaption}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}" />

                <TextBox Text="{Binding Justification}"
                         Height="68"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Padding="8,4" />

                <!-- ===== Favourites section ===== -->
                <!-- Visible whenever there are saved chips OR the current text
                     is non-empty + not already saved. Divider + caption mirror
                     the ELIGIBILITIES/ACTIVE convention so the section reads as
                     a first-class group, not loose UI chrome. -->
                <StackPanel Spacing="6"
                            Margin="0,4,0,0"
                            IsVisible="{Binding HasFavoritesOrSaveable}">
                  <Border Background="{DynamicResource BorderDividerBrush}"
                          Height="1" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="FAVOURITES"
                               FontSize="{DynamicResource FontCaption}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="ghost"
                            Padding="6,1"
                            Command="{Binding SaveCurrentJustificationCommand}"
                            IsVisible="{Binding CanSaveCurrentJustification}"
                            ToolTip.Tip="Save the current justification as a reusable favourite for this role">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="+"
                                   FontSize="{DynamicResource FontSmall}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Save current"
                                   FontSize="{DynamicResource FontCaption}"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>

                  <!-- Favourite rows: full-width list. TextBlock trims with
                       CharacterEllipsis so longer texts are visible up to the
                       window edge instead of being chopped at 32 chars in a
                       pill. Click the row body to apply, ✕ to delete; tooltip
                       carries the full text. -->
                  <ItemsControl ItemsSource="{Binding JustificationFavorites}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:JustificationFavoriteViewModel">
                        <Border CornerRadius="6"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,4">
                          <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0"
                                    Classes="ghost"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="10,6,6,6"
                                    CornerRadius="6,0,0,6"
                                    Command="{Binding $parent[ItemsControl].((vm:ActivationPanelViewModel)DataContext).ApplyFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding FullText}">
                              <TextBlock Text="{Binding Label}"
                                         FontSize="{DynamicResource FontSmall}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         TextTrimming="CharacterEllipsis" />
                            </Button>
                            <!-- ✕ delete: TextBlock with the U+2715 glyph
                                 instead of PathIcon — open-path geometry on
                                 PathIcon renders nothing under fill. -->
                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Padding="6,6,10,6"
                                    CornerRadius="0,6,6,0"
                                    Command="{Binding $parent[ItemsControl].((vm:ActivationPanelViewModel)DataContext).DeleteFavoriteCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="Delete favourite">
                              <TextBlock Text="✕"
                                         FontSize="11"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Center" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <!-- Ticket -->
              <StackPanel IsVisible="{Binding RequiresTicket}" Spacing="8">
                <StackPanel>
                  <TextBlock Text="Ticket number"
                             FontSize="{DynamicResource FontCaption}"
                             FontWeight="Medium"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             Margin="0,0,0,4" />
                  <TextBox Text="{Binding TicketNumber}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Ticket system"
                             FontSize="{DynamicResource FontCaption}"
                             FontWeight="Medium"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             Margin="0,0,0,4" />
                  <TextBox Text="{Binding TicketSystem}" />
                </StackPanel>
              </StackPanel>

              <!-- Banners -->
              <Border Background="{DynamicResource WarningSoftBrush}"
                      CornerRadius="6"
                      Padding="10,8"
                      IsVisible="{Binding ShowApprovalBanner}">
                <TextBlock Text="ℹ This activation requires approval."
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSmall}"
                           Foreground="{DynamicResource WarningBrush}" />
              </Border>
              <Border Background="{DynamicResource WarningSoftBrush}"
                      CornerRadius="6"
                      Padding="10,8"
                      IsVisible="{Binding ShowAuthContextBanner}">
                <TextBlock Text="ℹ This activation may require additional verification (MFA)."
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSmall}"
                           Foreground="{DynamicResource WarningBrush}" />
              </Border>
              <Border Background="{DynamicResource WarningSoftBrush}"
                      CornerRadius="6"
                      Padding="10,8"
                      IsVisible="{Binding ShowRoleAssignableBanner}">
                <TextBlock Text="⚠ This group can carry directory roles. Activating it may grant more than group membership."
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSmall}"
                           Foreground="{DynamicResource WarningBrush}" />
              </Border>

              <!-- Validation success -->
              <Border Background="{DynamicResource SuccessSoftBrush}"
                      CornerRadius="6"
                      Padding="10,8"
                      IsVisible="{Binding ValidationSuccess,
                                          Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ValidationSuccess}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSmall}"
                           Foreground="{DynamicResource SuccessBrush}" />
              </Border>

              <!-- Validation failure -->
              <Border Background="{DynamicResource DangerSoftBrush}"
                      CornerRadius="6"
                      Padding="10,8"
                      IsVisible="{Binding ValidationMessage,
                                          Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ValidationMessage}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSmall}"
                           Foreground="{DynamicResource DangerBrush}" />
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Footer -->
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,18,0,0">
            <Button Grid.Column="0"
                    Classes="ghost"
                    Command="{Binding ValidateCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    IsVisible="{Binding CanValidate}">
              <Panel>
                <TextBlock Text="Validate"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !IsValidating}" />
                <StackPanel Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsValidating}">
                  <Border Classes="spinner" Width="13" Height="13">
                    <Border.RenderTransform>
                      <RotateTransform />
                    </Border.RenderTransform>
                    <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 1,6.5"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          StrokeThickness="1.6"
                          StrokeLineCap="Round" />
                  </Border>
                  <TextBlock Text="Validating…" VerticalAlignment="Center" />
                </StackPanel>
              </Panel>
            </Button>
            <Button Grid.Column="2"
                    Classes="secondary"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="3"
                    Classes="primary"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding !IsBusy}">
              <Panel>
                <TextBlock Text="Activate"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !IsSubmitting}" />
                <StackPanel Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsSubmitting}">
                  <Border Classes="spinner" Width="13" Height="13">
                    <Border.RenderTransform>
                      <RotateTransform />
                    </Border.RenderTransform>
                    <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 1,6.5"
                          Stroke="{DynamicResource AccentForegroundBrush}"
                          StrokeThickness="1.6"
                          StrokeLineCap="Round" />
                  </Border>
                  <TextBlock Text="Activating…" VerticalAlignment="Center" />
                </StackPanel>
              </Panel>
            </Button>
          </Grid>
        </Grid>
      </Border>

      <!-- ============================== -->
      <!-- Slide-in: connect to additional tenant -->
      <!-- ============================== -->

      <Border IsVisible="{Binding AddTenantPanel.IsOpen}"
              Background="{DynamicResource Surface1Brush}"
              CornerRadius="12"
              Padding="14"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <Border.RenderTransform>
          <TranslateTransform X="{Binding AddTenantPanel.PanelOffsetX}" />
        </Border.RenderTransform>
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="(TranslateTransform.X)"
                              Duration="0:0:0.28"
                              Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>

        <Grid RowDefinitions="Auto,*,Auto"
              DataContext="{Binding AddTenantPanel}"
              x:DataType="vm:AddTenantPanelViewModel">

          <!-- Header -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0"
                    Classes="icon"
                    Command="{Binding CancelCommand}"
                    ToolTip.Tip="Back">
              <PathIcon Data="M15 6l-6 6 6 6" Width="14" Height="14" />
            </Button>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Add account"
                         FontSize="{DynamicResource FontTitleSmall}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Sign in with an admin account"
                         FontSize="{DynamicResource FontSmall}"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Grid>

          <!-- Body -->
          <ScrollViewer Grid.Row="1" Margin="0,18,0,0" Classes="popup">
            <StackPanel Spacing="14">
              <!-- Hidden when the tenant was already chosen in Settings, and when only
                   one is configured — either way there is nothing to choose. -->
              <StackPanel IsVisible="{Binding IsTargetChoiceVisible}">
                <TextBlock Text="Sign in with"
                           FontSize="{DynamicResource FontCaption}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding SignInTargets}"
                          SelectedItem="{Binding SelectedTarget}"
                          IsEnabled="{Binding !IsConnecting}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AddTenantPanelViewModel+SignInTarget">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Each entry signs in to its own tenant. China routes auth via login.partner.microsoftonline.cn and Graph via microsoftgraph.chinacloudapi.cn."
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSmall}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,6,0,0" />
              </StackPanel>

              <TextBlock Text="The Windows account picker opens after Sign in. Choose an account that is a member or guest of the selected tenant — the same identity can be enrolled in several tenants. To sign in to a tenant that is not listed, add it under Settings → Tenants first."
                         TextWrapping="Wrap"
                         FontSize="{DynamicResource FontSmall}"
                         Foreground="{DynamicResource TextTertiaryBrush}" />

              <!-- Error -->
              <Border Background="{DynamicResource DangerSoftBrush}"
                      CornerRadius="6"
                      Padding="10,8"
                      IsVisible="{Binding ErrorMessage,
                                          Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource FontSmall}"
                           Foreground="{DynamicResource DangerBrush}" />
              </Border>

              <!-- Advanced: device-code escape hatch -->
              <StackPanel Spacing="10">
                <Button Classes="ghost"
                        Command="{Binding ToggleAdvancedCommand}"
                        HorizontalAlignment="Left"
                        Padding="4,2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="M9 6l6 6-6 6" Width="11" Height="11"
                              Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Advanced"
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Button>

                <StackPanel Spacing="10" IsVisible="{Binding IsAdvancedExpanded}">
                  <TextBlock TextWrapping="Wrap"
                             FontSize="{DynamicResource FontSmall}"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             Text="Sign in with a device code on another device (e.g. your phone). Use this when your organization's federated sign-in (e.g. Okta) keeps signing you in as the wrong account. Note: this may be blocked by Conditional Access policies that require a managed device." />

                  <!-- Device-code instructions, shown once the code arrives -->
                  <Border Background="{DynamicResource Surface2Brush}"
                          CornerRadius="6"
                          Padding="12,10"
                          IsVisible="{Binding IsDeviceCodeInProgress}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="On your phone, open:"
                                 FontSize="{DynamicResource FontSmall}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <SelectableTextBlock Text="{Binding DeviceCodeVerificationUri}"
                                           FontSize="{DynamicResource FontSmall}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                      <TextBlock Text="and enter this code:"
                                 FontSize="{DynamicResource FontSmall}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Margin="0,4,0,0" />
                      <SelectableTextBlock Text="{Binding DeviceCodeUserCode}"
                                           FontSize="{DynamicResource FontTitleSmall}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}" />

                      <!-- Escape hatch: stays clickable while the rest of the
                           panel is disabled during the poll, so the user can back
                           out instead of waiting out the 10-minute window. -->
                      <Button Classes="secondary"
                              HorizontalAlignment="Left"
                              Margin="0,8,0,0"
                              Command="{Binding CancelDeviceCodeCommand}"
                              Content="Cancel sign-in" />
                    </StackPanel>
                  </Border>

                  <Button Classes="secondary"
                          HorizontalAlignment="Left"
                          Command="{Binding ConnectViaDeviceCodeCommand}"
                          IsEnabled="{Binding !IsConnecting}"
                          Content="Sign in with device code" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Footer -->
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
            <Button Grid.Column="1"
                    Classes="secondary"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding !IsConnecting}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="2"
                    Classes="primary"
                    Command="{Binding ConnectCommand}"
                    IsEnabled="{Binding !IsConnecting}">
              <Panel>
                <TextBlock Text="Sign in"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !IsConnecting}" />
                <StackPanel Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsConnecting}">
                  <Border Classes="spinner" Width="13" Height="13">
                    <Border.RenderTransform>
                      <RotateTransform />
                    </Border.RenderTransform>
                    <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 1,6.5"
                          Stroke="{DynamicResource AccentForegroundBrush}"
                          StrokeThickness="1.6"
                          StrokeLineCap="Round" />
                  </Border>
                  <TextBlock Text="Signing in…" VerticalAlignment="Center" />
                </StackPanel>
              </Panel>
            </Button>
          </Grid>
        </Grid>
      </Border>

      <!-- ============================== -->
      <!-- Slide-in settings              -->
      <!-- ============================== -->

      <Border IsVisible="{Binding SettingsPanel.IsOpen}"
              Background="{DynamicResource Surface1Brush}"
              CornerRadius="12"
              Padding="14"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <Border.RenderTransform>
          <TranslateTransform X="{Binding SettingsPanel.PanelOffsetX}" />
        </Border.RenderTransform>
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="(TranslateTransform.X)"
                              Duration="0:0:0.28"
                              Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>

        <Grid RowDefinitions="Auto,*"
              DataContext="{Binding SettingsPanel}"
              x:DataType="vm:SettingsPanelViewModel">

          <!-- Header: back arrow + title -->
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0"
                    Classes="icon"
                    Command="{Binding CloseCommand}"
                    ToolTip.Tip="Back">
              <PathIcon Data="M15 6l-6 6 6 6" Width="14" Height="14" />
            </Button>
            <TextBlock Grid.Column="1"
                       Text="Settings"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource FontTitleSmall}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </Grid>

          <!-- Body -->
          <ScrollViewer Grid.Row="1" Margin="0,18,0,0" Classes="popup">
            <StackPanel Spacing="10">

              <!-- =========== TENANTS =========== -->
              <!-- One card per tenant, with the accounts signed into it nested
                   inside. The configuration is shared by every account in the
                   tenant — one App Registration, one ticket system — so it lives
                   one level above the rows it applies to rather than being
                   repeated in each of them. The list is also the whitelist of
                   tenants that can be signed in to. Registrations are saved to
                   %LocalAppData%\junis\Entra-PIM-Manager\appsettings.local.json
                   (outside the install dir so it survives Velopack updates) and
                   take effect on the next process start — MSAL's clients are
                   built from the startup configuration. -->
              <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <!-- Header doubles as the collapse toggle. The green check is
                     only ever shown for a configuration a sign-in has actually
                     proven — see SettingsPanelViewModel.AreAppRegistrationsVerified. -->
                <Button Classes="ghost"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        Command="{Binding ToggleTenantsSectionCommand}">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="TENANTS"
                               FontSize="{DynamicResource FontCaption}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Background="{DynamicResource SuccessSoftBrush}"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding AreAppRegistrationsVerified}"
                            ToolTip.Tip="An account signed in successfully with every configured App Registration.">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="Verified"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource SuccessBrush}" />
                      </StackPanel>
                    </Border>
                    <PathIcon Grid.Column="3"
                              Data="M9 6l6 6-6 6"
                              Width="10" Height="10"
                              Foreground="{DynamicResource TextTertiaryBrush}"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !IsTenantsSectionExpanded}" />
                    <PathIcon Grid.Column="3"
                              Data="M6 9l6 6 6-6"
                              Width="10" Height="10"
                              Foreground="{DynamicResource TextTertiaryBrush}"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsTenantsSectionExpanded}" />
                  </Grid>
                </Button>

                <StackPanel Spacing="8" IsVisible="{Binding IsTenantsSectionExpanded}">
                  <TextBlock Text="One card per tenant: its App Registration, its ticket system, and the accounts signed into it. A multi-tenant registration is listed once per tenant with the same client id."
                             FontSize="{DynamicResource FontSmall}"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             TextWrapping="Wrap" />

                  <!-- One banner for the whole section, above the cards: inside a
                       collapsed configuration disclosure it would be invisible
                       exactly when it matters. -->
                  <Border Background="{DynamicResource SuccessSoftBrush}"
                          CornerRadius="6"
                          Padding="10,8"
                          IsVisible="{Binding ShowRestartPrompt}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0"
                                 Text="Saved. Restart the app to apply the change."
                                 FontSize="{DynamicResource FontSmall}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1"
                              Classes="primary"
                              Content="Restart now"
                              Command="{Binding RestartAppCommand}" />
                    </Grid>
                  </Border>

                  <ItemsControl ItemsSource="{Binding Nodes}"
                                ItemTemplate="{StaticResource TenantNodeTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>

                  <!-- Adding a tenant. Always reachable, and the only thing on
                       screen when nothing is configured yet — the first-run state
                       must not be an empty list with no way forward. -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="Add a tenant"
                               FontSize="{DynamicResource FontCaption}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBox Text="{Binding NewTenantId}"
                             PlaceholderText="Tenant id — 00000000-0000-0000-0000-000000000000"
                             FontSize="{DynamicResource FontBody}" />
                    <TextBox Text="{Binding NewClientId}"
                             PlaceholderText="Client id — 00000000-0000-0000-0000-000000000000"
                             FontSize="{DynamicResource FontBody}" />
                    <TextBox Text="{Binding NewLabel}"
                             PlaceholderText="Label (optional)"
                             FontSize="{DynamicResource FontBody}" />
                    <TextBox Text="{Binding NewTicketSystem}"
                             PlaceholderText="Ticket system (optional) — e.g. ServiceNow"
                             ToolTip.Tip="Prefilled into the activation form for this tenant when a role requires a ticket. Takes effect immediately and stays editable per activation."
                             FontSize="{DynamicResource FontBody}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <ComboBox Grid.Column="0"
                                ItemsSource="{Binding CloudOptions}"
                                SelectedItem="{Binding NewTenantCloud}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:SettingsPanelViewModel+CloudOption">
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="1"
                              Classes="primary"
                              Content="Add"
                              Command="{Binding AddTenantCommand}" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              </Border>

              <!-- =========== APPEARANCE =========== -->
              <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Text="APPEARANCE"
                           FontSize="{DynamicResource FontCaption}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <TextBlock Grid.Column="0"
                             Text="Theme"
                             FontSize="{DynamicResource FontBody}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding SelectedTheme}"
                            MinWidth="130">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingsPanelViewModel+ThemeOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
              </Border>

              <!-- =========== BEHAVIOR =========== -->
              <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Text="BEHAVIOR"
                           FontSize="{DynamicResource FontCaption}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}" />

                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows"
                               FontSize="{DynamicResource FontBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Launches the tray app when you sign in."
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding StartWithWindows}"
                                OnContent=""
                                OffContent="" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"
                      IsVisible="{Binding CanManageStartMenuShortcut}">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Start menu entry"
                               FontSize="{DynamicResource FontBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Keep a shortcut in the Start menu to find and pin the app."
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding CreateStartMenuShortcut}"
                                OnContent=""
                                OffContent="" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Default activation duration"
                               FontSize="{DynamicResource FontBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Used as the starting value of the duration slider."
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding DurationOptions}"
                            SelectedItem="{Binding SelectedDuration}"
                            MinWidth="110">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingsPanelViewModel+DurationOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
              </Border>

              <!-- =========== NOTIFICATIONS =========== -->
              <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Text="NOTIFICATIONS"
                           FontSize="{DynamicResource FontCaption}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}" />

                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Notify before expiry"
                               FontSize="{DynamicResource FontBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Toast when an active role nears its expiry."
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding ExpiryWarningEnabled}"
                                OnContent=""
                                OffContent="" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Warning threshold"
                               FontSize="{DynamicResource FontBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="How early the warning toast fires."
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding ExpiryThresholdOptions}"
                            SelectedItem="{Binding SelectedExpiryThreshold}"
                            IsEnabled="{Binding ExpiryWarningEnabled}"
                            MinWidth="120">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingsPanelViewModel+ExpiryThresholdOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </StackPanel>
              </Border>

              <!-- =========== UPDATES =========== -->
              <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Text="UPDATES"
                           FontSize="{DynamicResource FontCaption}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}" />

                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Automatic updates"
                               FontSize="{DynamicResource FontBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Check GitHub for new releases and offer to install them."
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding AutomaticUpdatesEnabled}"
                                OnContent=""
                                OffContent="" />
                </Grid>

              </StackPanel>
              </Border>

              <!-- =========== DIAGNOSTICS =========== -->
              <Border Classes="settings-card">
              <StackPanel Spacing="8">
                <TextBlock Text="DIAGNOSTICS"
                           FontSize="{DynamicResource FontCaption}"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Log detail"
                               FontSize="{DynamicResource FontBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Applies immediately. Debug records full sign-in detail for troubleshooting — log files grow large."
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding LogLevelOptions}"
                            SelectedItem="{Binding SelectedLogLevel}"
                            MinWidth="130"
                            VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SettingsPanelViewModel+LogLevelOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Log files"
                               FontSize="{DynamicResource FontBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Open the folder with the rolling log files — useful when reporting a problem."
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Command="{Binding OpenLogCommand}"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                Width="14" Height="14" />
                      <TextBlock Text="Open log folder" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>

                <!-- Network check: probes the endpoints the app and the WAM
                     sign-in window need, per configured cloud. Built for the
                     field case where the sign-in window opens but stays blank
                     inside a locked-down customer network. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Network check"
                               FontSize="{DynamicResource FontBody}"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Probe the sign-in, Graph and update endpoints this app and the Windows sign-in window need — useful when the sign-in window stays blank."
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="secondary"
                          Command="{Binding RunNetworkCheckCommand}"
                          IsEnabled="{Binding !IsNetworkCheckRunning}"
                          VerticalAlignment="Center">
                    <Panel>
                      <TextBlock Text="Run check"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding !IsNetworkCheckRunning}" />
                      <StackPanel Orientation="Horizontal" Spacing="8"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsNetworkCheckRunning}">
                        <Border Classes="spinner" Width="13" Height="13">
                          <Border.RenderTransform>
                            <RotateTransform />
                          </Border.RenderTransform>
                          <Path Data="M 6.5,1 A 5.5,5.5 0 1 1 1,6.5"
                                Stroke="{DynamicResource TextSecondaryBrush}"
                                StrokeThickness="1.6"
                                StrokeLineCap="Round" />
                        </Border>
                        <TextBlock Text="Checking…" VerticalAlignment="Center" />
                      </StackPanel>
                    </Panel>
                  </Button>
                </Grid>

                <!-- Results: one section per probed group (configured clouds,
                     then the update feed). Same dot badge convention as the
                     App Registration card — green means confirmed everywhere. -->
                <StackPanel Spacing="10" IsVisible="{Binding HasNetworkCheckResults}">
                  <ItemsControl ItemsSource="{Binding NetworkCheckGroups}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NetworkCheckGroupViewModel">
                        <StackPanel Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="{DynamicResource FontSmall}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding ProxyLabel}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                          <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:NetworkCheckRowViewModel">
                                <StackPanel Spacing="1">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding IsPass}" />
                                    <Ellipse Width="6" Height="6"
                                             Fill="{DynamicResource DangerBrush}"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding !IsPass}" />
                                    <TextBlock Text="{Binding Host}"
                                               FontSize="{DynamicResource FontSmall}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                  </StackPanel>
                                  <TextBlock Margin="14,0,0,0"
                                             Text="{Binding DetailLabel}"
                                             FontSize="10"
                                             Foreground="{DynamicResource TextTertiaryBrush}"
                                             TextWrapping="Wrap"
                                             IsVisible="{Binding IsPass}" />
                                  <TextBlock Margin="14,0,0,0"
                                             Text="{Binding DetailLabel}"
                                             FontSize="10"
                                             Foreground="{DynamicResource DangerBrush}"
                                             TextWrapping="Wrap"
                                             IsVisible="{Binding !IsPass}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="{Binding NetworkCheckCaveat}"
                             FontSize="{DynamicResource FontSmall}"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             TextWrapping="Wrap" />

                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Classes="secondary"
                            Content="Copy report"
                            Command="{Binding CopyNetworkReportCommand}" />
                    <TextBlock Grid.Column="1"
                               Text="Copied"
                               FontSize="{DynamicResource FontSmall}"
                               Foreground="{DynamicResource SuccessBrush}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding ReportCopied}" />
                  </Grid>
                </StackPanel>
              </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      </Grid>

      <!-- ============================== -->
      <!-- Footer: version · author · GitHub -->
      <!-- ============================== -->

      <Border Grid.Row="1"
              BorderBrush="{DynamicResource BorderDividerBrush}"
              BorderThickness="0,1,0,0"
              Padding="12,5,8,5">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
          <TextBlock Grid.Column="0"
                     Text="{Binding VersionText}"
                     FontSize="{DynamicResource FontCaption}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Text="junis GmbH"
                     FontSize="{DynamicResource FontCaption}"
                     Foreground="{DynamicResource TextTertiaryBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,4,0" />
          <Button Grid.Column="3"
                  Classes="icon"
                  Width="22" Height="22"
                  Command="{Binding OpenGitHubCommand}">
            <PathIcon Data="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-1.93c-3.2.69-3.88-1.55-3.88-1.55-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.27 1.19-3.07-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39s1.97.13 2.89.39c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.8 1.19 1.82 1.19 3.07 0 4.39-2.68 5.37-5.24 5.66.41.36.78 1.08.78 2.17v3.21c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
                      Width="12" Height="12" />
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
