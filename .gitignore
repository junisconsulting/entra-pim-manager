# Build output
bin/
obj/
[Rr]eleases/
artifacts/
*.user
*.suo

# Local config — never commit real tenant/client IDs
appsettings.local.json

# IDE
.vs/
.idea/
*.DotSettings.user

# Claude Code — shared procedures are tracked; personal settings and scratch files are not
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/hooks/
!.claude/settings.json
# The manual test checklist IS the release gate — the `release` skill refuses to
# tag without a signed-off run. Untracked it existed on one machine only.
!.claude/manual-test-checklist.md

# Velopack / packaging output
packaging/**/output/
packaging/velopack/publish/
packaging/velopack/releases/
*.nupkg

# Test / coverage
[Tt]est[Rr]esults/
coverage*.xml
*.coverage
